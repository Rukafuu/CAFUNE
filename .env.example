# .env.example — Copie para .env e preencha os valores
#
# cp .env.example .env

# Chave da API Gemini (necessária para RLAIF com professor externo)
# Obtenha em: https://aistudio.google.com/apikey
OPENROUTER_API_KEY=sua_chave_aqui

# Diretório opcional para mmap e outros artefatos de execução.
# CAFUNE_RUNTIME_DIR=C:/caminho/para/runtime
# CAFUNE_MODEL_PATH=C:/caminho/para/cafune_model.bson
# CAFUNE_SNN_PATH=C:/caminho/para/snn_weights.bson

# Integração legada opcional.
# GEMINI_API_KEY=sua_chave_aqui

# Caminho para o módulo Raegis (opcional — modo heurístico se ausente)
# RAEGIS_PATH=C:/caminho/para/Raegis/python
